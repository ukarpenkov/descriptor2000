{
  "name": "descriptor2000",
  "version": "2.0.0",
  "private": true,
  "description": "Local audio and video transcription",
  "author": "ukarpenkov",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "dependencies": {
    "@elysiajs/node": "1.4.5",
    "@huggingface/transformers": "^3.8.1",
    "@sinclair/typebox": "0.34.52",
    "elysia": "^1.4.0",
    "exact-mirror": "0.2.9",
    "ffmpeg-static": "^5.3.0",
    "file-type": "22.3.0",
    "onnx-asr-web": "^0.1.3",
    "openapi-types": "12.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.descriptor2000.app",
    "productName": "Descriptor2000",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnx-asr-web/node_modules/onnxruntime-web/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraFiles": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ]
  }
}
